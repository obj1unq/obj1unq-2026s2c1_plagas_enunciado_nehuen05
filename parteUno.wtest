import elementos.*

describe "group of tests for villa" {

  test "mascota es buena" {
    const felipe = new Mascota(nivelDeSalud = 300)
    assert.that(felipe.esBueno() )
  }

  test "mascota es mala" {
    const tristepe = new Mascota(nivelDeSalud = 240)
    
    assert.notThat( tristepe.esBueno() )
  }

  test "mi Hogar es bueno" {
    const miCasa = new Hogar(nivelDeMugre= 10, nivelDeConfort=20 )
    assert.that(miCasa.esBueno() )
  }

  test "mi Hogar es malo" {
    const miCasa = new Hogar(nivelDeMugre= 10, nivelDeConfort=5 )
    assert.notThat( miCasa.esBueno() )
  }

  test "Huerta es buena" {
    const cultivo = new Huerta(nivelDeProduccion= 20)
    assert.that( cultivo.esBueno() )
  }

  test "Huerta es mala" {
    const cultivo = new Huerta(nivelDeProduccion = 10)
    assert.notThat( cultivo.esBueno() )
  }

  test "villa es copada" {
    const villa = new Elemento()
    const mascota = new Mascota(nivelDeSalud= 300)
    const hogar = new Hogar(nivelDeMugre= 10, nivelDeConfort=20 )
    const huerta = new Huerta(nivelDeProduccion= 10)

    villa.agregarElemento(mascota)
    villa.agregarElemento(hogar)
    villa.agregarElemento(huerta)

    assert.that(villa.esCopado() )
  }

  test "villa no es copada" {
    const villa = new Elemento()
    const mascota = new Mascota(nivelDeSalud= 200)
    const hogar = new Hogar(nivelDeMugre= 15, nivelDeConfort=20 )
    const huerta = new Huerta(nivelDeProduccion= 10)

    villa.agregarElemento(mascota)
    villa.agregarElemento(hogar)
    villa.agregarElemento(huerta)

    assert.notThat(villa.esCopado() )
  }


}